{
  "name": "fastify-crud-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "start:dev": "cross-env NODE_ENV=development nodemon",
    "build": "node esbuild.config.mjs",
    "start:prod": "npm run type-check && npm run build && cross-env NODE_ENV=production node dist/main.js",
    "start:multi": "npm run build && cross-env NODE_ENV=production MULTI_MODE=true node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest"
  },
  "dependencies": {
    "@fastify/env": "^5.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
